&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME /beegfs/kos28364/GW100/2_input_and_script/POTENTIAL
    &MGRID
      CUTOFF 800
      REL_CUTOFF 80
    &END MGRID
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-14
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER WAVELET
    &END POISSON
    &SCF
      EPS_SCF 1.0E-7
      SCF_GUESS RESTART
      MAX_SCF 300
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        RCOND_MINIMAX 1.0E-10
        ANALYTIC_CONTINUATION PADE
        AC_FALLBACK .TRUE.
        MEMORY_PER_PROC 33
        NUM_TIME_FREQ_POINTS 34
        FREQ_MAX_FIT 1.0E6
        NPARAM_PADE 0
        QP_START_DFT
        EPS_FILTER              1.0E-10
        CUTOFF_RADIUS_RI             11
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 27 27 27
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME 57_AlF3.xyz
      COORD_FILE_FORMAT xyz
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND H
      BASIS_SET def2-QZVP
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
